<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guonl.flow.db.mapper.FlowRunMapper">

    <resultMap id="BaseResultMap" type="com.guonl.flow.db.entity.FlowRunDO">
        <id column="run_id" property="runId"/>
        <result column="flow_id" property="flowId"/>
        <result column="flow_name" property="flowName"/>
        <result column="status" property="status"/>
        <result column="input_summary" property="inputSummary"/>
        <result column="input_images" property="inputImages"/>
        <result column="input_rows" property="inputRows"/>
        <result column="cost_millis" property="costMillis"/>
        <result column="total_tokens" property="totalTokens"/>
        <result column="start_at" property="startAt"/>
        <result column="end_at" property="endAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        run_id, flow_id, flow_name, status, input_summary, input_images, input_rows,
        cost_millis, total_tokens, start_at, end_at
    </sql>

    <insert id="insert" parameterType="com.guonl.flow.db.entity.FlowRunDO">
        INSERT INTO flow_run (run_id, flow_id, flow_name, status, input_summary, input_images, input_rows,
                              cost_millis, total_tokens, start_at, end_at)
        VALUES (#{runId}, #{flowId}, #{flowName}, #{status}, #{inputSummary}, #{inputImages}, #{inputRows},
                #{costMillis}, #{totalTokens}, #{startAt}, #{endAt})
    </insert>

    <update id="updateFinish" parameterType="com.guonl.flow.db.entity.FlowRunDO">
        UPDATE flow_run
        SET status = #{status},
            cost_millis = #{costMillis},
            end_at = #{endAt},
            total_tokens = #{totalTokens}
        WHERE run_id = #{runId}
    </update>

    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM flow_run
        WHERE run_id = #{runId}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM flow_run
        ORDER BY start_at DESC
    </select>

    <!-- 条件片段：运行ID/流程模糊、状态精确、开始时间范围（epoch毫秒，含起止两天） -->
    <sql id="Search_Condition">
        <where>
            <if test="runId != null and runId != ''">
                AND run_id LIKE CONCAT('%', #{runId}, '%')
            </if>
            <if test="flow != null and flow != ''">
                AND (flow_name LIKE CONCAT('%', #{flow}, '%') OR flow_id LIKE CONCAT('%', #{flow}, '%'))
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="startFromMs != null">
                AND start_at &gt;= #{startFromMs}
            </if>
            <if test="startToMs != null">
                AND start_at &lt;= #{startToMs}
            </if>
        </where>
    </sql>

    <select id="searchPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM flow_run
        <include refid="Search_Condition"/>
        ORDER BY start_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countSearch" resultType="long">
        SELECT COUNT(*)
        FROM flow_run
        <include refid="Search_Condition"/>
    </select>

    <!-- Dashboard 统计：单条SQL聚合（llmCalls=成功执行的LLM节点数） -->
    <select id="selectStats" resultMap="StatsResultMap">
        SELECT COUNT(*)                                                              AS total,
               COALESCE(SUM(CASE WHEN status = 'RUNNING' THEN 1 ELSE 0 END), 0)      AS running,
               COALESCE(SUM(CASE WHEN status = 'SUCCESS' THEN 1 ELSE 0 END), 0)      AS success,
               COALESCE(SUM(CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END), 0)       AS failed,
               COALESCE(AVG(cost_millis), 0)                                         AS avgCostMillis,
               COALESCE(SUM(total_tokens), 0)                                        AS totalTokens,
               (SELECT COUNT(*) FROM flow_node_execution
                 WHERE model IS NOT NULL AND model != '' AND status = 'SUCCESS')      AS llmCalls
        FROM flow_run
    </select>

    <resultMap id="StatsResultMap" type="com.guonl.flow.db.entity.RunStatsDO">
        <result column="total" property="total"/>
        <result column="running" property="running"/>
        <result column="success" property="success"/>
        <result column="failed" property="failed"/>
        <result column="avgCostMillis" property="avgCostMillis"/>
        <result column="totalTokens" property="totalTokens"/>
        <result column="llmCalls" property="llmCalls"/>
    </resultMap>
</mapper>
